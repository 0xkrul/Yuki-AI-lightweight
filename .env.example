# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: Perspective API Key (for enhanced AI moderation)
# Get free key at: https://perspectiveapi.com/
# Without this, bot uses fast heuristic-based detection (works offline!)
PERSPECTIVE_API_KEY=

# Database (if using asyncpg)
DATABASE_URL=postgresql://user:password@localhost/dbname
